{
  "manifest_version": 2,
  "name": "macOS External PiP Bridge",
  "version": "0.1.1",
  "description": "Streams the current page video to a local always-on-top macOS helper window.",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "webNavigation",
    "webRequest",
    "<all_urls>",
    "http://127.0.0.1:41243/*",
    "ws://127.0.0.1:41243/*"
  ],
  "browser_action": {
    "default_title": "Open video in macOS PiP",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-macos-pip@pluttan.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
